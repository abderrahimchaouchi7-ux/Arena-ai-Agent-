# ---------------------------------------------------------------------------
# RABT environment
#
# Copy to `.env.local` and fill in. Every value is OPTIONAL — the app runs
# with zero configuration; Google Sign-In simply falls back to a clearly
# labelled demo mode until you supply credentials.
# ---------------------------------------------------------------------------

# --- Google Sign-In (optional) ---------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Type: OAuth 2.0 Client ID -> Web application
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
#
# Leave both blank to use the demo sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (optional) -----------------------------------------------------
# Where the SQLite database and uploaded images are written.
# Defaults to ./data  (git-ignored).
# RABT_DATA_DIR=./data

# --- Public base URL (only needed behind a proxy) ---------------------------
# NEXT_PUBLIC_SITE_URL=https://rabt.example.com
