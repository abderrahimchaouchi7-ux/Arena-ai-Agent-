# ---------------------------------------------------------------------------
# Nur Al-Iman — environment example
# ---------------------------------------------------------------------------
# Copy to `.env.local` and adjust. NOTHING here is required for the app to run:
# every feature works offline from the data already bundled in src/data/
# generated/. These variables only control *optional* remote enhancement.
#
# No secrets belong in this project. The app is a static PWA: whatever you put
# here is shipped to the browser inside the JS bundle, so a value placed here
# must be safe to publish. Never add API keys, tokens or credentials.
# ---------------------------------------------------------------------------

# --- Optional: remote adhan audio -----------------------------------------
# Base URL of a server you are licensed to stream from. The catalogue in
# src/lib/audio.ts resolves each muezzin to `${VITE_ADHAN_BASE_URL}/<file>`.
# Leave unset to use the built-in probe-and-fallback behaviour, which shows an
# honest "source unavailable" state and lets the user import their own file.
#
# IMPORTANT: do not point this at recordings you have no right to redistribute.
# See docs/DATA-SOURCES.md for the licensing position.
VITE_ADHAN_BASE_URL=

# --- Optional: full hadith collections on demand --------------------------
# The bundled offline packs carry ~300 hadiths per collection. Setting this
# lets the Hadith page offer the complete collection as a lazy download,
# cached in IndexedDB. Must be a URL you control and may serve from.
VITE_HADITH_FULL_BASE_URL=

# --- Optional: Quran recitation audio -------------------------------------
# Per-ayah recitation base URL. The default uses the public everyayah CDN
# paths recorded in src/lib/audio.ts; override only to self-host.
VITE_QURAN_AUDIO_BASE_URL=

# --- Build-time flags ------------------------------------------------------
# 1 enables the service worker during `npm run dev`, which is useful for
# testing offline behaviour but makes hot reload confusing. Default off.
PWA_DEV=0

# Public base path, if the site is not served from the domain root.
# The default './' keeps relative URLs so the bundle also works from file://
# inside the Android WebView.
VITE_BASE_URL=./
